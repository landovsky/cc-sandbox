#!/bin/sh
# image/git-shim: the `git` a fenced agent runs (plan §3 U1a). It exists because the fence has no
# credentials and cannot write the git dir (mounted read-only): a commit or push is not done here but
# ASKED for, as a request file in the outbox (/run/ccsbx/out/requests), which the host daemon reads,
# judges and performs; the answer comes back in /run/ccsbx/in/replies. Read verbs go to the real git
# (/usr/lib/git-core/git; it is not on PATH, so only this script calls it by name).
# This is convenience, not a boundary: the fence can still run the real binary by path, and what
# keeps it from writing history is the read-only git dir and the missing credentials. The host must
# re-check every request it gets (remote, refspec, message size), exactly as if this shim did not exist.
#
#   git [-C P] [-c K=V] [--git-dir P] [--work-tree P] [--no-pager] ... VERB   global options are parsed:
#                                  the verb is the first word after them, not an option's value
#   git status|log|diff|show|...   passed to the real git unchanged (the read list below);
#                                  --output*, -O*, --open-files-in-pager and `reflog expire|delete` refused
#   git commit -m MSG [-a]         request {"type":"git.commit","message":MSG,"all":bool}
#   git push [REMOTE [REFSPEC]]    request {"type":"git.push","remote":..,"refspec":..}; REMOTE must be a
#                                  configured remote NAME (never a URL), REFSPEC SRC or SRC:DST of plain
#                                  ref characters: no '+' (force), no empty source (delete), no flags,
#                                  and never main/master as the destination
#   anything else                  refused with exit 1 and a message
# Recipes: CCSBX_OUT / CCSBX_IN override the outbox/inbox (tests); CCSBX_GIT_TIMEOUT seconds to wait
# for the answer (default 120). A reply must appear whole (the host writes a temp file and renames
# it). The request format is the shim's side of the contract; the daemon's handler for git.* is built
# in the git route (not in this image).
set -u
REAL=/usr/lib/git-core/git
OUT=${CCSBX_OUT:-/run/ccsbx/out}
IN=${CCSBX_IN:-/run/ccsbx/in}
WAIT=${CCSBX_GIT_TIMEOUT:-120}
refuse() { echo "git: $*" >&2; exit 1; }

# clean_ref NAME: slash-separated components, none empty, '.', '..' or starting with '-'.
clean_ref() {
  case "$1" in ""|/*|*/|*//*) return 1;; esac
  _old=$IFS; IFS=/; set -f
  for _c in $1; do
    case "$_c" in ""|.|..|-*) IFS=$_old; set +f; return 1;; esac
  done
  IFS=$_old; set +f
  return 0
}
# check_c_value K=V: a -c setting that would run a program (convenience: the host is the boundary).
check_c_value() {
  _k=$(printf '%s' "${1%%=*}" | tr 'A-Z' 'a-z')
  case "$_k" in
    diff.external|*.textconv|*.command|core.pager|pager.*|core.fsmonitor|core.hookspath|core.sshcommand|core.askpass|core.editor|alias.*|include.path|includeif.*|credential.*|url.*)
      refuse "-c $_k is not allowed in the fence (it can run a program)";;
  esac
}
# find_verb ARGS...: sets VERB (empty if none) and NSKIP (how many words come before it).
find_verb() {
  VERB=""; NSKIP=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -c) [ $# -ge 2 ] || refuse "option -c needs a value"; check_c_value "$2"; NSKIP=$((NSKIP + 2)); shift 2;;
      -C|--git-dir|--work-tree|--namespace) [ $# -ge 2 ] || refuse "option $1 needs a value"; NSKIP=$((NSKIP + 2)); shift 2;;
      --git-dir=*|--work-tree=*|--namespace=*|--no-pager|-P|--no-optional-locks|--no-replace-objects|--literal-pathspecs|--no-lazy-fetch) NSKIP=$((NSKIP + 1)); shift;;
      --version|--help|-h|-v) VERB=""; return 0;;
      -*) refuse "option '$1' before the verb is not supported in the fence";;
      *) VERB=$1; return 0;;
    esac
  done
}
find_verb "$@"
[ $# -eq 0 ] && exec "$REAL"
if [ -z "$VERB" ]; then
  # Only `git --version` / `git --help` style, with nothing else after.
  case "$*" in "--version"|"--help"|"-h"|"-v") exec "$REAL" "$@";; esac
  refuse "no verb"
fi

# A word after the verb that makes a read verb write a file or run a program.
check_read_args() {
  skip=$NSKIP
  for a in "$@"; do
    if [ "$skip" -gt 0 ]; then skip=$((skip - 1)); continue; fi
    case "$a" in
      --output|--output=*|--ou|--ou=*|--ou[!r]*|-O*|--open-files-in-pager*|--open-f*|--ext-diff|--ext-*) refuse "$a is not allowed in the fence (it writes a file or runs a program)";;
    esac
  done
}
# The word right after the verb (for `reflog <sub>`).
sub_after_verb() { shift "$NSKIP"; shift; echo "${1:-}"; }

case "$VERB" in
  status|log|diff|show|blame|rev-parse|rev-list|ls-files|ls-tree|cat-file|grep|describe|shortlog|\
  name-rev|merge-base|diff-tree|diff-files|diff-index|show-ref|for-each-ref|check-ignore|help|version|\
  whatchanged|count-objects|var|cherry|range-diff)
    check_read_args "$@"; exec "$REAL" "$@" ;;
  reflog)
    case "$(sub_after_verb "$@")" in ""|show|list|exists) check_read_args "$@"; exec "$REAL" "$@";; *) refuse "reflog $(sub_after_verb "$@") is not allowed in the fence";; esac ;;
  commit|push)
    [ "$NSKIP" -eq 0 ] || refuse "$VERB takes no global options in the fence"
    ;;
  *) refuse "$VERB is not available in the fence; reads, 'git commit' and 'git push' are. (The host does the writing.)" ;;
esac

# --- build the request -------------------------------------------------------------------------
shift   # past the verb
case "$VERB" in
  commit)
    msg=""; have=0; all=false
    while [ $# -gt 0 ]; do
      case "$1" in
        -m) [ $# -ge 2 ] || refuse "commit: -m needs a message"; [ "$have" = 0 ] || refuse "commit: only one -m (the host writes the message as given)"; msg=$2; have=1; shift 2;;
        -a|--all) all=true; shift;;
        -am) [ $# -ge 2 ] || refuse "commit: -am needs a message"; [ "$have" = 0 ] || refuse "commit: only one -m"; all=true; msg=$2; have=1; shift 2;;
        *) refuse "commit: only -m MESSAGE and -a are supported in the fence (got '$1')";;
      esac
    done
    [ -n "$msg" ] || refuse "commit: -m MESSAGE is required"
    body=$(jq -cn --arg m "$msg" --argjson a "$all" '{type:"git.commit",message:$m,all:$a}') || refuse "commit: cannot encode the message" ;;
  push)
    remote=""; refspec=""; upstream=false
    for a in "$@"; do
      case "$a" in
        -u|--set-upstream) [ -z "$remote" ] || refuse "push: $a goes before the remote"; upstream=true; continue;;
      esac
      if [ -z "$remote" ]; then remote=$a
      elif [ -z "$refspec" ]; then refspec=$a
      else refuse "push: too many arguments"; fi
    done
    if [ -n "$remote" ]; then
      printf '%s' "$remote" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$' || refuse "push: '$remote' is not a remote name (a URL or a flag is not allowed)"
      "$REAL" remote 2>/dev/null | grep -Fxq -- "$remote" || refuse "push: '$remote' is not a configured remote"
    fi
    if [ -n "$refspec" ]; then
      printf '%s' "$refspec" | grep -Eq '^[A-Za-z0-9._/][A-Za-z0-9._/-]*(:[A-Za-z0-9._/][A-Za-z0-9._/-]*)?$' \
        || refuse "push: refspec '$refspec' is not allowed (no '+' force, no ':ref' delete, no flags; SRC or SRC:DST)"
      src=${refspec%%:*}
      case "$refspec" in *:*) dst=${refspec#*:};; *) dst=$src;; esac
      clean_ref "$src" || refuse "push: source '$src' is not a clean ref name (no empty, '.', '..' or '-' components)"
      # The destination is a bare branch name (ONE component) or refs/heads/<clean name>. Anything
      # else, such as heads/main (git expands it to refs/heads/main) or refs/heads//main, is refused,
      # and the check is on the NORMALISED name, not on the text.
      case "$dst" in
        refs/heads/*) dname=${dst#refs/heads/}; clean_ref "$dname" || refuse "push: destination '$dst' is not a clean ref name";;
        */*) refuse "push: destination '$dst' must be a branch name or refs/heads/<name>";;
        *) dname=$dst; clean_ref "$dname" || refuse "push: destination '$dst' is not a clean ref name";;
      esac
      case "$dname" in main|master) refuse "push: pushing to $dname is not allowed from the fence";; esac
    fi
    [ -z "$refspec" ] || [ -n "$remote" ] || refuse "push: a refspec needs a remote"
    body=$(jq -cn --arg r "$remote" --arg s "$refspec" --argjson u "$upstream" '{type:"git.push",remote:$r,refspec:$s,set_upstream:$u}') ;;
esac

# --- send it and wait for the answer -------------------------------------------------------------
rid="git-$(date +%s%N)-$$"          # time-ordered, matches the daemon's name rule [A-Za-z0-9_-]{1,64}
dir="$OUT/requests"
[ -d "$dir" ] || refuse "$VERB: no outbox at $dir (is this a ccsbx fence?)"
printf '%s\n' "$body" > "$dir/.$rid.tmp" && mv "$dir/.$rid.tmp" "$dir/$rid.json" \
  || refuse "$VERB: cannot write the request"
reply="$IN/replies/$rid.json"
i=0
while [ ! -s "$reply" ]; do
  i=$((i + 1))
  [ "$i" -gt $((WAIT * 4)) ] && refuse "$VERB: no answer from the host within ${WAIT}s (request $rid)"
  sleep 0.25
done
status=$(jq -r '.status // "error"' "$reply" 2>/dev/null) || refuse "$VERB: the host's reply is not valid JSON"
echo "git $VERB: $(jq -c '.result // {}' "$reply")"
case "$status" in ok|queued) exit 0;; *) refuse "$VERB: refused by the host ($status)";; esac
