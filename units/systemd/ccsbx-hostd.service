# ccsbx-hostd.service (U3a/U0). The per-machine daemon: journal, stamping, start API on :7480.
# Why: the daemon runs unprivileged so a bug in it is not root; it asks ccsbx-root for the few things that need it.
# It runs as uid ccsbx, can reach the signer's socket (group ccsbx) but never the key directory,
# and reaches docker only through `sudo -n /usr/local/sbin/ccsbx-root <verb>`.
# Flags are the design; hostd's Go code must accept exactly these.
# SupplementaryGroups=ccsbx-clients: hostd may chgrp its local socket to that group (a process can only
# chgrp to a group it is in), so the owner's `ccsbx` CLI can connect (review M1).
# The sandbox below is inherited by `sudo ccsbx-root` (it stays in this mount namespace), review M2.
# Chosen: ccsbx-root stays under hostd and the sandbox is widened by exactly what it needs:
# /home READ-ONLY (it must see the workdirs under the allowed roots to realpath them; dockerd, outside
# this namespace, does the real mount) and writes only under /var/lib/ccsbx and /run/ccsbx.
# Why not a separate root unit: that needs ccsbx-root to be a service, which is its own design; to be
# agreed with the U3a/hostd builder before the gate. Anything else ccsbx-root writes must be added here.
[Unit]
Description=ccsbx hostd (journal, stamping, start API)
After=network-online.target ccsbx-signer.socket
Wants=network-online.target
Requires=ccsbx-signer.socket

[Service]
Type=simple
User=ccsbx
Group=ccsbx
SupplementaryGroups=ccsbx-clients
ExecStart=/usr/local/libexec/ccsbx/ccsbx-hostd --state /var/lib/ccsbx --signer /run/ccsbx-signer/sign.sock --listen :7480 --local-socket /run/ccsbx/hostd.sock --socket-group ccsbx-clients
StateDirectory=ccsbx
StateDirectoryMode=0750
RuntimeDirectory=ccsbx
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
# NoNewPrivileges must stay OFF: hostd calls sudo for ccsbx-root. Everything else is closed.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/lib/ccsbx /run/ccsbx

[Install]
WantedBy=multi-user.target
