# ccsbx-signer.socket (U0b). The signer's unix socket, made by systemd (root) so it can be owned
# ccsbx-keys and grouped ccsbx: hostd (group ccsbx) connects, nobody else, and the key directory stays 0700.
# Why: an unprivileged signer can't chgrp its own socket to a group it is not in, so a socket it made itself
# would be unreachable for hostd and every token mint would fail after the gate (review M1).
[Unit]
Description=ccsbx signer socket

[Socket]
ListenStream=/run/ccsbx-signer/sign.sock
SocketUser=ccsbx-keys
SocketGroup=ccsbx
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
